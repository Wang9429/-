# 复制为 deploy/.env 后按实际镜像源修改。不要写入密钥。
#
# 国内 Docker Hub 镜像示例（择一，以当时可用为准）：
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# 阿里云公共镜像（需对应仓库名，按控制台文档填写）：
# NODE_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/node:22-bookworm-slim

NODE_IMAGE=node:22-bookworm-slim
NGINX_IMAGE=nginx:1.27-alpine
NPM_REGISTRY=https://registry.npmmirror.com
